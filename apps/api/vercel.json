{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.x",
  "ignoreCommand": "node scripts/skip-ci.js",
  "crons": [
    {
      "path": "/cron/keep-alive",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/cron/complete-reservations",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/cron/waitlist-timeout",
      "schedule": "0 3 * * *"
    }
  ]
}
